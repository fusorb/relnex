# Relnex Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` - see docs/environment.md for the full contract.

# --- Runtime ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ---
# One role per repo, owning only the `relnex` database. Never a shared cross-repo role.
DATABASE_URL=postgresql://relnex_app:PASSWORD@127.0.0.1:5432/relnex?schema=public

# --- SovGrant (identity provider service, code prefix sg) ---
SG_API_URL=http://localhost:4000
SG_CLIENT_ID=relnex
# Browser-side (public) SovGrant config for facet-sdk. NOT secret - exposed to the client.
NEXT_PUBLIC_SG_API_URL=http://localhost:4000
NEXT_PUBLIC_SG_CLIENT_ID=relnex
SG_ISSUER=sovgrant
# Verify tokens via SovGrant's JWKS (RS256) - the production anchor. SovGrant
# publishes the RSA access-token signing key (with a kid) in this set.
SG_JWKS_URL= # e.g. http://localhost:4000/api/v1/oauth/jwks
# Dev/e2e only: HS256 shared secret, used when SG_JWKS_URL is unset (SovGrant
# signs HS256 only while no RSA key pair is configured).
# MUST match SovGrant's JWT_SECRET.
SG_JWT_SECRET= # generate with: openssl rand -hex 32
# M2M token for server-to-server calls to SovGrant.
SG_SERVICE_TOKEN= # get via: POST {SG_API_URL}/oauth/token (client_credentials)
# MUST match SovGrant's WEBHOOK_SIGNING_SECRET.
SG_WEBHOOK_SECRET= # generate with: openssl rand -hex 32

# --- Storage (S3-compatible: Cloudflare R2, AWS S3, MinIO, etc.) ---
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT= # omit for native AWS S3; required for Cloudflare R2 / local dev
STORAGE_BUCKET_NAME=relnex-media
STORAGE_REGION=auto # use "auto" for Cloudflare R2
NEXT_PUBLIC_STORAGE_PUBLIC_URL= # public CDN base for stored media (optional)

# --- Optional AWS-native overrides ---
# AWS_ACCESS_KEY_ID=      # fallback for STORAGE_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=  # fallback for STORAGE_SECRET_ACCESS_KEY
# AWS_REGION=             # fallback for STORAGE_REGION
# AWS_BUCKET_NAME=        # fallback for STORAGE_BUCKET_NAME
