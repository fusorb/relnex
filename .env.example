# Relnex Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file with actual credentials.

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/relnex?schema=public

# --- SovGrant (identity provider service, code prefix sg) ---
SG_API_URL=http://localhost:4000
SG_CLIENT_ID=relnex
SG_JWT_SECRET= # generate with: openssl rand -hex 32
SG_SERVICE_TOKEN= # M2M token for server-to-server calls to SovGrant
SG_WEBHOOK_SECRET= # generate with: openssl rand -hex 32

# --- Next.js ---
JWT_SECRET= # generate with: openssl rand -hex 32

# --- Storage (S3-compatible: Cloudflare R2, AWS S3, MinIO, etc.) ---
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT= # omit for native AWS S3; required for Cloudflare R2 / local dev
STORAGE_BUCKET_NAME=relnex-media
STORAGE_REGION=auto # use "auto" for Cloudflare R2

# --- Optional overrides ---
# AWS_ACCESS_KEY_ID=      # alternative to STORAGE_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=  # alternative to STORAGE_SECRET_ACCESS_KEY
# AWS_REGION=             # alternative to STORAGE_REGION
