# ─────────────────────────────────────────────────────────────────
# SovGrant Integration — add these to your Relnex .env
# ─────────────────────────────────────────────────────────────────

# URL of your SovGrant Fastify service
SG_API_URL="http://localhost:4000"

# MUST match SovGrant JWT_SECRET exactly — the shared trust anchor
SG_JWT_SECRET="SAME_VALUE_AS_SG_JWT_SECRET"

# Issuer claim in SovGrant JWTs (must match SovGrant JWT_ISSUER)
SG_ISSUER="sovgrant"

# OAuth client registered in SovGrant for Relnex
SG_CLIENT_ID="relnex"
SG_CLIENT_SECRET="the_secret_returned_when_you_registered_relnex_client"

# M2M service token — get via:
#   POST http://localhost:4000/oauth/token
#   grant_type=client_credentials&client_id=relnex&client_secret=...
SG_SERVICE_TOKEN=""

# Webhook verification secret — must match SovGrant WEBHOOK_SIGNING_SECRET
SG_WEBHOOK_SECRET="SAME_VALUE_AS_SG_WEBHOOK_SIGNING_SECRET"
