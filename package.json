{
  "name": "relnex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate",
    "prisma:run": "npx prisma validate && pnpm prisma:format && pnpm prisma:generate && pnpm prisma:migrate",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs-sync.mjs",
    "check:legacy": "node scripts/check-legacy-names.mjs",
    "check:env": "node scripts/check-env-sync.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:openapi": "node scripts/check-openapi-sync.mjs",
    "check:all": "pnpm check:docs && pnpm check:legacy && pnpm check:env && pnpm check:boundaries && pnpm check:openapi && pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@fusorb/facet-auth": "^2.1.2",
    "@fusorb/facet-components": "^3.2.2",
    "@fusorb/facet-layout": "^1.7.2",
    "@fusorb/facet-sdk": "4.0.1",
    "@fusorb/facet-store": "^1.0.6",
    "@fusorb/facet-tokens": "^1.5.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@tanstack/react-query": "^5.100.11",
    "@upstash/redis": "^1.38.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.39.0",
    "jose": "^6.2.3",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.6",
    "swagger-ui-react": "^5.32.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3"
  }
}
